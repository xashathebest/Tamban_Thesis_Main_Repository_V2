.DS_Store
Thumbs.db

# Training artifacts
*.pt
*.pth
*.onnx
*.tflite
*.engine
*.mlmodel

# Generated image derivatives. Immutable raw images are versioned with Git LFS
# using the repository's .gitattributes rules.
dataset/cleaned/**/*
dataset/standardized/**/*
dataset/masks/**/*
dataset/crops/**/*
dataset/splits/**/*
# Git cannot re-include a file while one of its parent directories remains
# ignored, so retain the documented directory skeleton explicitly.
!dataset/**/
!dataset/**/README.md
!dataset/**/.gitkeep

# Local audit/runtime scratch data
tmp/
.audit_tmp/
Ultralytics/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Generated QA and benchmark results
results/qa/

# Temporary dependency and audit outputs
../tmp/

